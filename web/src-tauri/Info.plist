<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 拾贝核心功能：会议录音。WKWebView getUserMedia 需要此声明才能弹权限框 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>拾贝需要使用麦克风录制会议音频，用于生成转录与纪要。录音仅保存在您的设备本地。</string>
    <!-- 摄像头暂不使用，但预留以备未来的视频会议记录功能 -->
    <key>NSCameraUsageDescription</key>
    <string>拾贝暂未使用摄像头；若未来支持视频会议记录时会再次询问。</string>
</dict>
</plist>
